oam/org-roam/issues/comments/2142989944","html_url":"https://github.com/org-roam/org-roam/issues/1997#issuecomment-2142989944","issue_url":"https://api.github.com/repos/org-roam/org-roam/issues/1997","id":2142989944,"node_id":"IC_kwDODdJkEs5_u254","user":{"login":"akashpal-21","id":46517170,"node_id":"MDQ6VXNlcjQ2NTE3MTcw","avatar_url":"https://avatars.githubusercontent.com/u/46517170?v=4","gravatar_id":"","url":"https://api.github.com/users/akashpal-21","html_url":"https://github.com/akashpal-21","followers_url":"https://api.github.com/users/akashpal-21/followers","following_url":"https://api.github.com/users/akashpal-21/following{/other_user}","gists_url":"https://api.github.com/users/akashpal-21/gists{/gist_id}","starred_url":"https://api.github.com/users/akashpal-21/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akashpal-21/subscriptions","organizations_url":"https://api.github.com/users/akashpal-21/orgs","repos_url":"https://api.github.com/users/akashpal-21/repos","events_url":"https://api.github.com/users/akashpal-21/events{/privacy}","received_events_url":"https://api.github.com/users/akashpal-21/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-05-31T21:18:06Z","updated_at":"2024-06-02T09:12:48Z","body":"I implemented Materialized View using Sqlite Triggers to offload computation to Sqlite \r\nI have provided benchmark for the case of 20k nodes, 30k tags, 10 aliases, and 10k refs. \r\n\r\nhttps://org-roam.discourse.group/t/materialized-view-for-org-roam-db-using-sqlite-triggers/3483/25\r\n\r\n```\r\n#+RESULTS:\r\n|        0.636916469 | 0 | 0.0 |\r\n|        0.644032131 | 0 | 0.0 |\r\n| 0.6499278900000001 | 0 | 0.0 |\r\n|        0.672380125 | 0 | 0.0 |\r\n|        0.654946752 | 0 | 0.0 |\r\n|        0.658287666 | 0 | 0.0 |\r\n|        0.667262851 | 0 | 0.0 |\r\n|        0.670634778 | 0 | 0.0 |\r\n|        0.695153822 | 0 | 0.0 |\r\n|        0.668818478 | 0 | 0.0 |\r\n|        0.686307308 | 0 | 0.0 |\r\n```\r\n\r\n```\r\n|         0.214723974 | 0 | 0.0 |\r\n|         0.210380056 | 0 | 0.0 |\r\n|         0.209768058 | 0 | 0.0 |\r\n|         0.211162957 | 0 | 0.0 |\r\n|         0.209120208 | 0 | 0.0 |\r\n|         0.231940973 | 0 | 0.0 |\r\n|         0.249701558 | 0 | 0.0 |\r\n| 0.25441987299999996 | 0 | 0.0 |\r\n| 0.25335254100000004 | 0 | 0.0 |\r\n| 0.25053876199999997 | 0 | 0.0 |\r\n| 0.25305776599999996 | 0 | 0.0 |\r\n```\r\nPlease have a look at the post for more detail - implementing it in elisp should be trivial from here, leaving it here for further consideration.\r\n\r\nThanks and Best,","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/org-roam/org-roam/issues/comments/2142989944/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/org-roam/org-roam/issues/comments/2143475249","html_url":"https://github.com/org-roam/org-roam/issues/1997#issuecomment-2143475249","issue_url":"https://api.github.com/repos/org-roam/org-roam/issues/1997","id":2143475249,"node_id":"IC_kwDODdJkEs5_wtYx","user":{"login":"publicimageltd","id":20790649,"node_id":"MDQ6VXNlcjIwNzkwNjQ5","avatar_url":"https://avatars.githubusercontent.com/u/20790649?v=4","gravatar_id":"","url":"https://api.github.com/users/publicimageltd","html_url":"https://github.com/publicimageltd","followers_url":"https://api.github.com/users/publicimageltd/followers","following_url":"https://api.github.com/users/publicimageltd/following{/other_user}","gists_url":"https://api.github.com/users/publicimageltd/gists{/gist_id}","starred_url":"https://api.github.com/users/publicimageltd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/publicimageltd/subscriptions","organizations_url":"https://api.github.com/users/publicimageltd/orgs","repos_url":"https://api.github.com/users/publicimageltd/repos","e